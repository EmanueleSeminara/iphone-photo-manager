# Configuration for the hardware test suite (tests/hardware/).
#
# Copy this file to `.ipm-hw.env` -- which is git-ignored -- and fill it in. The
# suite refuses to run without IPM_HW_UDID: it will not guess which iPhone it may
# touch. Environment variables of the same names win over this file.
#
#   pytest -m hardware -q            # read-only, safe on any phone
#
# Find the UDID with the phone plugged in:
#
#   .venv/bin/python -c "import asyncio; from pymobiledevice3 import usbmux; \
#     print(asyncio.run(usbmux.list_devices())[0].serial)"

# The one iPhone this suite is allowed to talk to. Required.
IPM_HW_UDID=

# A destination folder that already has an import history, so the delete plan can
# be built from real rows. Optional: the tests that need it skip when it is unset.
IPM_HW_DESTINATION=

# The phone that may LOSE PHOTOS. Deliberately a second setting: being allowed to
# read from a device is not the same as being allowed to delete from it, and saying
# which phone may lose photos should take an explicit act rather than following from
# IPM_HW_UDID. It must name the same phone as IPM_HW_UDID, and even then nothing
# happens without --allow-delete and a non-empty sacrificial list.
#
# Leave it empty until you are actually running the destructive test.
IPM_HW_DESTRUCTIVE_UDID=

# Phones that must never be deleted from, whatever else is configured.
# Comma-separated. This overrides both settings above and --allow-delete.
#
# Put here any phone that might get plugged into this Mac and must not be touched:
# someone else's, or an old one you keep as an archive. Put your own here too once
# you have a spare phone to test deletion on -- from that day your own phone should
# never be a delete target again.
#
# While you are testing deletion on your own phone, leave this empty: this setting
# and IPM_HW_DESTRUCTIVE_UDID would contradict each other and the test would refuse.
# What protects the phone meanwhile is tests/hardware/sacrificial.txt, which names
# the only photos that may go, plus the ceiling of three items in the code.
IPM_HW_PROTECTED_UDIDS=

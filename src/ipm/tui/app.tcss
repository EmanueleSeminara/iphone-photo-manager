/* Layout of the single main screen, plus the two modal dialogs. */

Screen {
    layout: vertical;
}

#panels {
    height: auto;
    padding: 1 1 0 1;
}

/* Height stays `auto` so a card always grows with its content -- `height: 100%`
   makes the two equal but clips whichever one outgrows the row. They are matched
   in app.py instead, by padding the shorter panel's text. */
.card {
    width: 1fr;
    height: auto;
    min-height: 11;
    border: round $primary 60%;
    padding: 0 1 1 1;
    margin: 0 1 0 0;
}

.card-title {
    text-style: bold;
    color: $accent;
    padding: 0 0 1 0;
}

#actions {
    height: auto;
    padding: 1 2 0 2;
}

#buttons {
    height: auto;
    padding: 0 0 1 0;
}

/* The three actions share the row evenly. Fixed widths left a ragged gap on the
   right and made the row read as three things dropped below the panels rather
   than one band of actions belonging to them. */
/* Outlines rather than filled slabs. Three saturated blocks of colour in a
   window that is otherwise dark grey is a lot of weight for controls that are
   idle most of the time; the colour coding -- blue import, red delete -- says
   as much as a border and text as it did as a slab. Chosen by the maintainer
   against the filled version, both seen in a real terminal. */
#buttons Button {
    width: 1fr;
    margin: 0 1 0 0;
    background: $surface;
    border: tall $panel;
    color: $text;
}

#buttons Button:hover {
    background: $panel;
}

#buttons #import-button {
    border: tall $primary;
    color: $primary;
}

#buttons #delete-button {
    border: tall $error;
    color: $error;
}

#buttons Button:disabled {
    border: tall $panel;
    color: $text-disabled;
}

/* The bar itself, not the widget around it, is what was 32 cells wide in the
   middle of the row -- the same ragged edge the buttons had. It is also hidden
   while nothing is running: a bar reading 0% when there is nothing to be 0% of
   says less than no bar at all. */
#progress {
    width: 100%;
    /* Hidden, not removed. `display: none` collapses the row, so the activity box
       jumped up a line every time a job ended and down again when the next one
       started. `visibility` keeps the space and only stops the painting. */
    visibility: hidden;
}

#progress Bar {
    width: 1fr;
}

#status-row {
    height: auto;
    padding: 0 0 1 0;
}

#status-label {
    color: $text-muted;
    text-style: bold;
    width: 8;
}

#progress-detail {
    color: $text-muted;
    width: 1fr;
}

#activity {
    height: 1fr;
    min-height: 6;
    border: round $primary 40%;
    border-title-color: $accent;
    border-title-style: bold;
    margin: 0 2 0 2;
    padding: 0 1;
}

/* --- narrow terminals ---------------------------------------------------
   Below NARROW_WIDTH columns the two panels no longer fit side by side: every
   line wraps and the buttons run off the right edge. Stacking them keeps an
   80-column terminal -- the default almost everywhere -- usable. The class is
   toggled in app.py, because Textual CSS has no media queries. */

Screen.-narrow #panels {
    layout: vertical;
    height: auto;
}

Screen.-narrow .card {
    width: 100%;
    /* Stacked, matching the heights would only add blank rows to the shorter
       card, and vertical space is what is short here. */
    min-height: 0;
    margin: 0 0 1 0;
}

/* Stacked cards make the screen taller than most terminals, so let it scroll
   rather than push the first panel off the top. */
Screen.-narrow {
    overflow-y: auto;
}

Screen.-narrow #activity {
    height: 1fr;
    min-height: 6;
}

/* The buttons stay on one row; their labels are shortened in app.py instead,
   which costs three lines of screen rather than nine. */
Screen.-narrow #buttons Button {
    margin: 0 1 0 0;
}

/* --- modal dialogs --- */

DestinationScreen, ConfirmDeleteScreen, ConfirmImportScreen, PermanentDeleteScreen {
    align: center middle;
    background: $background 70%;
}

#destination-dialog, #confirm-dialog, #import-dialog, #permanent-dialog {
    width: 80;
    max-width: 90%;
    height: auto;
    /* The delete dialog grew a scope chooser: on a short terminal it must scroll
       rather than have its confirm button clipped off the bottom. */
    max-height: 90%;
    overflow-y: auto;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#confirm-dialog {
    border: thick $error;
}

#permanent-dialog {
    border: thick $error;
}

/* The sentence the dialog exists for, so it does not read as more prose. */
#permanent-warning {
    padding: 1 2;
    background: $boost;
}

.dialog-title {
    text-style: bold;
    padding: 0 0 1 0;
}

.dialog-danger {
    color: $error;
}

.dialog-help {
    color: $text-muted;
    padding: 1 0;
}

.dialog-warning {
    color: $warning;
}

.dialog-error {
    color: $error;
}

.dialog-buttons {
    height: auto;
    align-horizontal: right;
    padding: 1 0 0 0;
}

.dialog-buttons Button {
    margin: 0 0 0 2;
}

#confirm-excluded {
    height: auto;
    max-height: 10;
    border: round $warning 50%;
    padding: 0 1;
}

#confirm-scope {
    height: auto;
    margin: 1 0 0 0;
    border: none;
    background: $surface;
}

#confirm-count-row {
    height: auto;
    padding: 0 0 0 4;
}

#confirm-count {
    width: 12;
}

#confirm-count-label {
    color: $text-muted;
    padding: 1 0 0 1;
}

#confirm-selection {
    padding: 1 0 0 0;
}

LibraryChangedScreen {
    align: center middle;
    background: $background 70%;
}

#changed-dialog {
    width: 84;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    overflow-y: auto;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#changed-list {
    height: auto;
    max-height: 8;
    border: round $warning 50%;
    margin: 1 0 0 0;
    padding: 0 1;
}
